# =====================================================================
# CAREPATH AI - PRODUCTION ENVIRONMENT CONFIGURATION
# =====================================================================

# Next.js App Environment
NEXT_PUBLIC_APP_NAME="CarePath AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Authentication & PostgreSQL Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-never-expose-to-frontend"

# Optional External AI Engine (e.g., Google Gemini / OpenAI)
# If not set, CarePath AI executes its built-in deterministic clinical navigation & safety engine
GEMINI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"

# Optional Maps Provider
# If empty, CarePath AI uses its built-in interactive OpenStreetMap / Leaflet navigation engine
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Security & Rate Limiting
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=30
AUDIT_LOG_ENABLED=true
